    "clip_norm": 1.0,
    "warmup_fraction": 0.05,
    "final_fraction": 0.1
  },
  "steps": 1500,
  "seed": 42,
  "device": "auto",
  "precision": "auto",
  "log_interval": 10,
  "eval_interval": 25,
