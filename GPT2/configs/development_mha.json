{
  "model": {
    "layers": 12,
    "dims": 768,
    "heads": 12,
    "seq_len": 128,
    "rate": 4,
    "dropout": 0.1,
    "attention": "mha",
    "positional_embedding": true
  },
  "data": {
    "vocab_path": "data/vocab.txt",
